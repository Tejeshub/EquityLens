# Copy to backend/.env and fill in. Never commit real values.
ENVIRONMENT=development                # development | test | production
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME   # legacy name POSTGRES_URL is still read
ALLOWED_ORIGINS=http://localhost:8080  # comma-separated browser origins (the Vercel URL in production)
# COOKIE_SECURE=true                   # defaults to true when ENVIRONMENT=production
SESSION_TTL_HOURS=168

# Data-source policy. public (default in production) = every restricted source OFF; personal = on (own/dev use only).
# A flag is NOT a licence: see docs/PROVIDERS.md before enabling anything for other people.
DATA_PROFILE=personal
# ENABLE_YAHOO=false
# ENABLE_SCREENER=false
# ENABLE_NSE_INDEX=false
# ENABLE_NEWS=false
# ENABLE_NEWS_EXCERPTS=false
# COPILOT_PROVIDER=groq            # gemini only with GEMINI_BILLING_ENABLED=true (see PROVIDERS.md P5)
# TRUSTED_PROXY_HOPS=0             # set only after measuring the proxy chain (docs/DEPLOYMENT.md section 7)
# DEBUG_PROXY_CHAIN=false

# Providers (names kept for compatibility; GROK_API_KEY is actually a Groq key)
GROK_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key
EXA_API_KEY=your_exa_api_key

# Budgets (conservative defaults; provider quotas are not verified - see docs/PROVIDERS.md)
RESEARCH_PER_USER_PER_DAY=5
ASK_PER_USER_PER_HOUR=30
LOGIN_ATTEMPTS_PER_15MIN=8
YAHOO_REQUESTS_PER_MINUTE=30
EXA_REQUESTS_PER_DAY=40
GROQ_REQUESTS_PER_DAY=500
# GEMINI_REQUESTS_PER_DAY=200
